// Nasadenie: bun web/nasad.ts (z koreňa projektu). Token Cloudflare je mimo repa.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rozvrh",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "rozvrh.dvoriste.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/v1/*", "/mcp"]
  },
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "2311", "simple": { "limit": 60, "period": 60 } }],
  "observability": { "enabled": true }
}
